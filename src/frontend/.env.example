# Công tắc backend giả — SDD 08 §7.
# (i)   Chỗ ở duy nhất của công tắc này. Không default nào nằm rải trong code
#       ngoài `api/analyze.ts`, và default ở đó là BẬT.
# (ii)  Suy ra từ: backend (W4) build sau frontend (W5) trong thứ tự lô của
#       SDD 00 §2, nên UI phải chạy được trước khi có API thật.
# (iii) Xem lại khi: `api/routes/analyze.py` phát được stream đúng hợp đồng
#       SDD 00 §5 — lúc đó đặt 0 và đối chiếu hai nhánh phải cho cùng UI.
VITE_USE_MOCK=1

# Gốc của REST + SSE khi VITE_USE_MOCK=0. Vite proxy /api → 127.0.0.1:8000.
VITE_API_BASE=/api
